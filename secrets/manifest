# Secrets manifest: every secret the stack uses, one row per secret.
#
# In each container a secret is the read-only file /run/secrets/<name>
# (Compose "secrets:" entries in docker-compose.yml / docker-compose-prod.yml).
#   uid      owner of the file in prod: the one non-root UID that reads it
#            (root readers such as front_end or the postgres entrypoint can
#            read any file)
#   envs     where it is used. Dev values are the committed dummy files in
#            secrets-dev/; prod values come from OpenBao via ./deploy.sh
#   kv_path  OpenBao path under infra/openvre/ (prod)
#   field    key inside that KV secret
#   from     legacy .env variable(s), only used by migrate-secrets.sh.
#            "A,B": both must hold the same value. "@VAR": VAR holds a path
#            to a file whose content is the value.
#
# name                    uid   envs      kv_path       field           from
mongo_root_password       999   dev,prod  mongo         root_password   MONGO_INITDB_ROOT_PASSWORD
mongo_app_password        999   dev,prod  mongo         app_password    MONGO_INITDB_PASSWORD
keycloak_client_secret    1000  dev,prod  keycloak      client_secret   KEYCLOAK_SECRET
keycloak_admin_password   1000  dev,prod  keycloak      admin_password  KEYCLOAK_ADMIN_PASSWORD
keycloak_db_password      1000  prod      keycloak      db_password     KEYCLOAK_DB_PASSWORD,POSTGRES_PASSWORD
mail_password             0     dev,prod  mail          password        MAIL_PASS
frontend_tls_key          0     prod      frontend-tls  key             @FRONTEND_SSL_KEY
