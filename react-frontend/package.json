{
  "name": "openvre-react-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt src vite.config.ts tsconfig.json tsconfig.node.json",
    "format:check": "oxfmt --check src vite.config.ts tsconfig.json tsconfig.node.json",
    "check": "npm run lint && npm run format:check && tsc -b"
  },
  "dependencies": {
    "lucide-react": "^1.26.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
