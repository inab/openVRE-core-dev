{
  "require": {
    "ext-openssl": "*",
    "auth0/auth0-php": "^8.0",
    "chadicus/slim-oauth2": "^3.1",
    "erusev/parsedown": "^1.7",
    "firebase/php-jwt": "^7.0",
    "guzzlehttp/guzzle": "*",
    "justinrainbow/json-schema": "^5.2",
    "league/oauth2-google": "^2.0",
    "mongodb/mongodb": "^2.1",
    "monolog/monolog": "^3.9",
    "phpmailer/phpmailer": "^7.0.0",
    "slim/extras": "*",
    "slim/http": "^1.3.0",
    "slim/psr7": "^1.6.0",
    "slim/slim": "4.*",
    "squizlabs/php_codesniffer": "^3.5",
    "swaggest/json-schema": "^0.12.34",
    "zircote/swagger-php": "^6.5",
    "phpseclib/phpseclib": "^3.0"
  },
  "require-dev": {
    "zircote/swagger-php": "^6.5"
  },
  "autoload": {
    "psr-4": {
      "OpenVRE\\": "public/phplib/classes/",
      "OpenVREAPI\\": "public/api/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Test\\": "tests"
    }
  },
  "scripts": {
    "docs": "openapi public/api/ -o public/api/docs/openapi.yaml"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}