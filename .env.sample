# Global settings
# Configuration applicable across multiple components

# FOR WINDOWS/WSL USE IP
SERVER_DOMAIN_PROTOCOL=http
SERVER_DOMAIN=localhost # or external FQDN
NETWORK_NAME=open-vre-network

# KEYCLOAK CONFIGURATION
# Authentication and user managment settings for Keycloak
KEYCLOAK_SERVER=http://172.21.0.12:8080 # OIDC server cannot be in the same domain as openVRE to work with mod_auth_openidc
KEYCLOAK_REALM=project
KEYCLOAK_CLIENT=open-vre
KEYCLOAK_SECRET=01234secretxxxxxxxxxxxxxxxxxxxxx
# Only required for local deployment
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=pass
KEYCLOAK_PORT=9099
KEYCLOAK_REALMS_DIR=./keycloak/realms
# Internal path (do not change)
KEYCLOAK_IMPORT_DIR=/opt/keycloak/data/import

# MONGODB CONFIGURATION
# Database settings for MongoDB
MONGO_SERVER=my-mongodb:27017
MONGO_MAIN_DB=openVRE
MONGO_INITDB_USERNAME=user
MONGO_INITDB_PASSWORD=user
# Only required for local deployment
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin
MONGO_PORT=27017
MONGO_VOLUME=mongo_data

# VAULT CONFIGURATION
# Secret managment settings for Vault
BAO_PORT=8089
BAO_ADDR=http://bao-server:8200
BAO_API_VERSION=v1
BAO_ROLENAME=user-role
BAO_SECRET_PATH=secret/data/

# AIRLOCK / DATA EXPORT CONFIGURATION
# Set DOWNLOAD_ENABLED=false to forbid direct downloads for every user of this instance
DOWNLOAD_ENABLED=true
# Leave AIRLOCK_URL empty to disable the export to Airlock
AIRLOCK_URL=https://airlock.demo-tre.bsc.es
# NFS mount shared with Airlock: path on the host and path inside the front_end container
AIRLOCK_STAGING_HOST_DIR=/mnt/airlock
AIRLOCK_STAGING_DIR=/airlock_staging
# Prefix of the logical URIs sent to Airlock (resolved by Airlock to the NFS)
AIRLOCK_TRE_URI_PREFIX=tre://
# Release destination for egress submissions (ids provided by the Airlock team)
AIRLOCK_RELEASE_TARGET=
AIRLOCK_RECIPIENT_GROUP=
# Airlock contract URI(s) for dct:conformsTo, comma separated (provided by the Airlock team)
AIRLOCK_CONFORMS_TO=
# Optional CA bundle to verify the Airlock API certificate
AIRLOCK_SSL_CAFILE=

# DOCKER CONFIGURATION
# Settings related to Docker
# Ensure that the Docker group ID matches your system configuration
# To find the Docker group ID: getent group docker
DOCKER_GROUP=455

# FRONTEND CONFIGURATION
# Front-end application settings
FRONTEND_PORT=8088
FRONTEND_HOSTNAME=front_end
FRONTEND_HOST_PATH=/home/openVRE-core-dev

# MAIL CONFIGURATION
MAIL_HOST=mail
MAIL_USER=mail
MAIL_PASS=pass

# User ID and group ID for the front-end
# These should match the IDs running the Docker containers
UID=1000
GID=1000

# Datasets
INCLUDE_EGA_DATASETS=false
INCLUDE_EXTERNAL_DATASETS=false
INCLUDE_HPC_DATASETS=false
INCLUDE_OPENSTACK_DATASETS=false
